rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsOrder() {
      return signedIn() && resource.data.clienteUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isAdmin() || ownsUser(uid);
      allow create: if false;
      allow update: if isAdmin() || (ownsUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'telefono', 'addresses'
        ])
        && (request.resource.data.displayName is string || request.resource.data.displayName == null)
        && (request.resource.data.photoURL is string || request.resource.data.photoURL == null)
        && (request.resource.data.telefono is string || request.resource.data.telefono == null)
        && request.resource.data.addresses is list);
      allow delete: if false;
    }

    match /roles/{roleId} {
      allow read, write: if isAdmin();
    }

    match /pedidos/{orderId} {
      allow read: if isAdmin() || ownsOrder();
      allow create, update, delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || ownsOrder();
      allow create, update, delete: if false;
    }

    match /productos/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /categorias/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /auditoria/{auditId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
